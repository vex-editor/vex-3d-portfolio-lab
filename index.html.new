<script type="importmap">
{
  "imports": {
    "three": "https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js",
    "three/addons/": "https://cdn.jsdelivr.net/npm/three@0.160.0/examples/jsm/"
  }
</script>
<style>
  :root { --bg:#05060d; --fg:#f3f2fa; --muted:#a8a7bb; --purple:#8B3DFF; --purple-deep:#6028bb; --purple-bright:#b99aff; --card:rgba(14,16,32,.88); --border:rgba(139,61,255,.28); }
  * { box-sizing:border-box; margin:0; padding:0; }
  html { scroll-behavior:smooth; }
  @media (prefers-reduced-motion:reduce) { html { scroll-behavior:auto; } }
  body { background:var(--bg); color:var(--fg); font-family:"Readex Pro",system-ui,sans-serif; line-height:1.7; overflow-x:hidden; }
  /* Violet glow background */
  .glow-bg { position:fixed; inset:0; z-index:-1; background:radial-gradient(ellipse 60% 50% at 50% 0%, rgba(139,61,255,.25), transparent 60%), radial-gradient(ellipse 40% 30% at 80% 80%, rgba(112,88,212,.15), transparent 50%), var(--bg); }
  /* 3D Canvas */
  #scene { position:fixed; inset:0; width:100%; height:100%; z-index:0; touch-action:pan-y; }
  main, nav, footer { position:relative; z-index:2; }
  /* Nav */
  .nav { position:sticky; top:0; display:flex; align-items:center; justify-content:space-between; padding:16px 5vw; backdrop-filter:blur(14px); background:rgba(6,7,15,.72); border-bottom:1px solid rgba(139,61,255,.14); z-index:50; }
  .nav-logo { font-weight:900; font-size:1.5rem; letter-spacing:3px; }
  .nav-logo span { color:var(--purple-bright); }
  .nav-links { display:flex; gap:24px; align-items:center; }
  .nav-links a { color:var(--muted); text-decoration:none; font-weight:600; font-size:.95rem; transition:color .2s; }
  .nav-links a:hover { color:var(--fg); }
  .btn { display:inline-flex; align-items:center; gap:8px; padding:12px 28px; border-radius:999px; font-weight:700; font-size:1rem; text-decoration:none; transition:transform .2s, box-shadow .2s, background .2s; font-family:inherit; }
  .btn-primary { background:linear-gradient(115deg,#6028bb,#823be5); color:#fff; box-shadow:0 8px 32px rgba(139,61,255,.3), inset 0 1px 0 rgba(255,255,255,.12); border:1px solid rgba(185,154,255,.5); }
  .btn-primary:hover { transform:translateY(-2px); box-shadow:0 12px 40px rgba(139,61,255,.5), inset 0 1px 0 rgba(255,255,255,.12); }
  .btn-ghost { border:1px solid var(--border); color:var(--fg); background:rgba(139,61,255,.1); }
  .btn-ghost:hover { background:rgba(139,61,255,.2); }
  /* Hero */
  .hero { min-height:100svh; display:flex; flex-direction:column; justify-content:center; align-items:center; text-align:center; padding:140px 6vw 80px; }
  .hero-kicker { color:var(--purple-bright); letter-spacing:4px; font-size:.8rem; font-weight:700; margin-bottom:18px; }
  .hero h1 { font-size:clamp(2.4rem, 8vw, 5.5rem); font-weight:900; line-height:1.2; text-shadow:0 4px 32px rgba(6,7,15,.9), 0 0 16px rgba(6,7,15,.7); }
  .grad { background:linear-gradient(115deg,#c2abff,#8b3dff 70%,#a97bff); -webkit-background-clip:text; background-clip:text; color:transparent; }
  .hero-sub { color:var(--muted); font-size:clamp(1rem, 2.4vw, 1.3rem); max-width:560px; margin:22px auto 34px; text-shadow:0 2px 14px rgba(6,7,15,.9); }
  .hero-actions { display:flex; gap:14px; flex-wrap:wrap; justify-content:center; }
  .scroll-hint { margin-top:48px; color:var(--muted); font-size:.85rem; opacity:.7; animation:float 3s ease-in-out infinite; }
  @keyframes float { 0%,100% { transform:translateY(0); } 50% { transform:translateY(-6px); } }
  @media (prefers-reduced-motion:reduce) { .scroll-hint { animation:none; } }
  /* Value strip */
  .value-strip { padding:40px 6vw; text-align:center; border-top:1px solid rgba(139,61,255,.1); border-bottom:1px solid rgba(139,61,255,.1); }
  .value-strip p { color:var(--muted); font-size:clamp(1rem, 2.2vw, 1.2rem); font-weight:500; }
  .value-strip .accent { color:var(--purple-bright); }
  /* Works coverflow */
  .works { padding:100px 6vw; }
  .works-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:48px; flex-wrap:wrap; gap:16px; }
  .works-header h2 { font-size:clamp(1.8rem, 4.5vw, 2.8rem); font-weight:900; }
  .works-header .dot { color:var(--purple-bright); }
  .coverflow { display:flex; gap:24px; overflow-x:auto; padding:40px 0 60px; scroll-snap-type:x mandatory; -webkit-overflow-scrolling:touch; }
  .coverflow::-webkit-scrollbar { height:8px; }
  .coverflow::-webkit-scrollbar-track { background:transparent; }
  .coverflow::-webkit-scrollbar-thumb { background:rgba(139,61,255,.4); border-radius:4px; }
  .cover-card { flex:0 0 clamp(280px, 45vw, 380px); scroll-snap-align:center; perspective:1000px; }
  .cover-card-inner { width:100%; aspect-ratio:9/16; border-radius:20px; overflow:hidden; background:#000; transform-style:preserve-3d; transition:transform .4s cubic-bezier(.2,.6,.2,1), box-shadow .4s; border:1px solid var(--border); position:relative; }
  .cover-card:hover .cover-card-inner { transform:rotateY(-8deg) rotateX(4deg) translateY(-12px) scale(1.02); box-shadow:0 32px 64px rgba(139,61,255,.25), 0 0 0 1px rgba(139,61,255,.4); }
  .cover-media { width:100%; height:100%; object-fit:cover; display:block; }
  .cover-overlay { position:absolute; inset:0; background:linear-gradient(180deg, transparent 40%, rgba(6,7,15,.95)); opacity:0; transition:opacity .3s; display:flex; align-items:flex-end; padding:20px; }
  .cover-card:hover .cover-overlay { opacity:1; }
  .cover-info h3 { font-size:1.1rem; font-weight:700; margin-bottom:4px; }
  .cover-info p { color:var(--muted); font-size:.9rem; }
  .cover-play { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; background:rgba(6,7,15,.35); color:var(--fg); text-decoration:none; font-weight:900; font-size:1rem; opacity:0; transition:opacity .3s; }
  .cover-card:hover .cover-play { opacity:1; }
  .cover-play::before { content:"▶"; display:flex; align-items:center; justify-content:center; width:64px; height:64px; border-radius:50%; background:linear-gradient(115deg,var(--purple-deep),var(--purple)); box-shadow:0 8px 30px rgba(139,61,255,.45); }
  .cover-glare { position:absolute; inset:0; border-radius:20px; pointer-events:none; opacity:0; transition:opacity .3s; background:radial-gradient(420px circle at var(--gx,50%) var(--gy,50%), rgba(112,88,212,.16), transparent 45%); }
  .cover-card:hover .cover-glare { opacity:1; }
  .works-empty { grid-column:1/-1; color:var(--muted); text-align:center; padding:40px; }
  /* Stats strip */
  .stats { padding:80px 6vw; background:linear-gradient(180deg, transparent, rgba(139,61,255,.03), transparent); border-top:1px solid rgba(139,61,255,.1); border-bottom:1px solid rgba(139,61,255,.1); }
  .stats-grid { display:grid; grid-template-columns:repeat(auto-fit, minmax(180px, 1fr)); gap:24px; max-width:1100px; margin:0 auto; }
  .stat-card { text-align:center; padding:24px; background:var(--card); border:1px solid var(--border); border-radius:20px; backdrop-filter:blur(8px); transition:border-color .3s, transform .3s; }
  .stat-card:hover { border-color:rgba(139,61,255,.6); transform:translateY(-4px); }
  .stat-icon { width:48px; height:48px; margin:0 auto 16px; border-radius:14px; background:linear-gradient(115deg,rgba(139,61,255,.2),rgba(112,88,212,.1)); display:flex; align-items:center; justify-content:center; color:var(--purple-bright); font-size:1.5rem; }
  .stat-value { font-size:clamp(2.5rem, 5vw, 3.5rem); font-weight:900; color:var(--purple-bright); line-height:1; margin-bottom:8px; }
  .stat-label { color:var(--muted); font-size:.95rem; font-weight:500; }
  /* About */
  .about { padding:100px 6vw; max-width:1100px; margin:0 auto; }
  .about-header { text-align:center; margin-bottom:60px; }
  .about-header h2 { font-size:clamp(1.8rem, 4.5vw, 2.8rem); font-weight:900; }
  .about-header .dot { color:var(--purple-bright); }
  .about-grid { display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:24px; }
  .about-card { background:var(--card); border:1px solid var(--border); border-radius:20px; padding:32px; backdrop-filter:blur(8px); transition:border-color .3s, transform .3s; }
  .about-card:hover { border-color:rgba(139,61,255,.6); transform:translateY(-4px); }
  .about-card h3 { font-size:1.25rem; font-weight:700; margin-bottom:12px; color:var(--purple-bright); }
  .about-card p { color:var(--muted); line-height:1.8; }
  /* Footer */
  footer { padding:32px 5vw; border-top:1px solid rgba(139,61,255,.12); color:var(--muted); font-size:.8rem; letter-spacing:1px; background:rgba(7,8,18,.92); }
  .footer-row { display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px; max-width:1100px; margin:0 auto; }
  .footer-socials { display:flex; gap:14px; align-items:center; }
  .footer-socials a { color:var(--muted); display:inline-flex; padding:8px; border-radius:50%; border:1px solid transparent; transition:color .2s, border-color .2s, transform .2s; }
  .footer-socials a:hover { color:var(--purple-bright); border-color:var(--border); transform:translateY(-2px); }
  .version { color:var(--purple-bright); font-weight:700; }
  /* Mobile player controls tweak for vex-player.js */
  @media (max-width:700px) { .vxp-bar { height:30px !important; gap:4px !important; padding:0 6px !important; bottom:0 !important; } .vxp-time { min-width:26px !important; font-size:10px !important; } .vxp-big { width:48px !important; height:48px !important; } .vxp-btn { width:24px !important; height:24px !important; } }
  /* Lang toggle */
  .lang-toggle { background:transparent; border:1px solid var(--border); color:var(--fg); padding:6px 12px; border-radius:999px; font-weight:600; font-size:.85rem; cursor:pointer; transition:background .2s, border-color .2s; font-family:inherit; }
  .lang-toggle:hover { background:rgba(139,61,255,.15); border-color:var(--purple-bright); }
  /* Focus visible */
  :focus-visible { outline:2px solid var(--purple-bright); outline-offset:4px; }
</style>
</head>
<body>
<div class="glow-bg" aria-hidden="true"></div>
<canvas id="scene" aria-hidden="true"></canvas>
<nav class="nav" role="navigation" aria-label="Main navigation">
  <a href="/" class="nav-logo" aria-label="VEX Home">VEX<span>.</span></a>
  <div class="nav-links">
    <a href="#works">أعمالي</a>
    <a href="#about">عن VEX</a>
    <button class="lang-toggle" id="lang-toggle" aria-label="تبديل اللغة">AR</button>
    <a href="https://wa.me/201558077266?text=%D8%A3%D9%87%D9%84%D8%A7%D9%8B+VEX+%F0%9F%91%8B+%D8%B9%D8%A7%D9%8A%D8%B2+%D8%A3%D8%B7%D9%84%D8%A8+%D8%B1%D9%8A%D9%84+%D9%84%D8%AA%D8%AC%D8%B1%D8%A8%D8%A9+%D8%A8%D8%B5%D8%B1%D9%8A%D8%A9+%D8%AC%D8%AF%D9%8A%D8%AF%D8%A9" class="btn btn-primary" id="cta-whatsapp" target="_blank" rel="noopener">واتساب</a>
  </div>
</nav>
<main>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-kicker">مونتاج ريلز</div>
    <h1 id="hero-title"><span class="grad">مونتاج ريلز<br>بإيقاع محسوب</span></h1>
    <p class="hero-sub">مش مجرد فيديو، دي تجربة. كل قطّة، كل انتقال، كل لون — محسوب يخدم الرسالة.</p>
    <div class="hero-actions">
      <a href="https://wa.me/201558077266?text=%D8%A3%D9%87%D9%84%D8%A7%D9%8B+VEX+%F0%9F%91%8B+%D8%B9%D8%A7%D9%8A%D8%B2+%D8%A3%D8%B7%D9%84%D8%A8+%D8%B1%D9%8A%D9%84+%D9%84%D8%AA%D8%AC%D8%B1%D8%A8%D8%A9+%D8%A8%D8%B5%D8%B1%D9%8A%D8%A9+%D8%AC%D8%AF%D9%8A%D8%AF%D8%A9" class="btn btn-primary btn-big" id="hero-cta" target="_blank" rel="noopener">ابدأ مشروعك</a>
      <a href="#works" class="btn btn-ghost">شوف الأعمال</a>
    </div>
    <p class="scroll-hint" aria-hidden="true">اسحب لاكتشاف المزيد ↓</p>
  </section>
  <div class="value-strip" aria-label="Value proposition">
    <p>مش مجرد فيديو، <span class="accent">دي تجربة</span>.</p>
  </div>
  <section class="works" id="works" aria-labelledby="works-title">
    <div class="works-header">
      <h2 id="works-title">أعم<span class="dot">.</span>الي</h2>
      <a href="niche.html" class="btn btn-ghost">كل البلاي ليستات →</a>
    </div>
    <div class="coverflow" id="work-coverflow" role="list" aria-label="Featured works">
      <p class="works-empty" id="works-loading">جاري تحميل الأعمال…</p>
    </div>
  </section>
